{
  "name": "gitorbit",
  "displayName": "GitOrbit",
  "description": "A professional and high-performance Git extension for VS Code.",
  "version": "1.0.0",
  "publisher": "selcuksarikoz",
  "icon": "assets/icons/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/selcuksarikoz/git-orbit"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "gitorbit-explorer": [
        {
          "id": "gitorbit.views.changes",
          "name": "Changes",
          "icon": "$(git-commit)",
          "when": "config.gitorbit.views.showChanges"
        },
        {
          "id": "gitorbit.views.localBranches",
          "name": "Local Branches",
          "icon": "$(git-branch)",
          "when": "config.gitorbit.views.showLocalBranches"
        },
        {
          "id": "gitorbit.views.graph",
          "name": "Graph",
          "icon": "$(graph)",
          "when": "config.gitorbit.views.showGraph"
        },
        {
          "id": "gitorbit.views.commits",
          "name": "Commits history",
          "icon": "$(git-commit)",
          "when": "config.gitorbit.views.showCommits"
        },
        {
          "id": "gitorbit.views.fileHistory",
          "name": "File history",
          "icon": "$(history)",
          "when": "config.gitorbit.views.showFileHistory"
        },
        {
          "id": "gitorbit.views.remoteBranches",
          "name": "Remote Branches",
          "icon": "$(git-branch)",
          "when": "config.gitorbit.views.showRemoteBranches"
        },
        {
          "id": "gitorbit.views.stashes",
          "name": "Stashes",
          "icon": "$(archive)",
          "when": "config.gitorbit.views.showStashes"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitorbit-explorer",
          "title": "GitOrbit",
          "icon": "assets/icons/toolbar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitorbit.openCommitDiff",
        "title": "Open Diff",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.startRemoteBranch",
        "title": "Create Remote Branch...",
        "category": "GitOrbit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitorbit.deleteBranch",
        "title": "Delete Branch",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.forceDeleteBranch",
        "title": "Force Delete Branch",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.deleteRemoteBranch",
        "title": "Delete Remote Branch",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.cherryPick",
        "title": "Cherry Pick",
        "category": "GitOrbit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitorbit.checkoutCommit",
        "title": "Checkout Commit",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.startBranch",
        "title": "Create Branch...",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.gitflow.menu",
        "title": "Create...",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.refreshViews",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.refreshChanges",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.showWelcome",
        "title": "Show Welcome Page",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.openSettings",
        "title": "Open Settings",
        "category": "GitOrbit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitorbit.pushBranch",
        "title": "Push",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.pullBranch",
        "title": "Pull",
        "category": "GitOrbit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitorbit.syncBranch",
        "title": "Sync",
        "category": "GitOrbit",
        "icon": "$(sync)"
      },
      {
        "command": "gitorbit.checkoutBranch",
        "title": "Checkout",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.saveStash",
        "title": "Stash",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.stashApply",
        "title": "Apply Stash",
        "category": "GitOrbit",
        "icon": "$(reply)"
      },
      {
        "command": "gitorbit.stashPop",
        "title": "Pop Stash",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.openCommitDiffs",
        "title": "Open Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitorbit.stashDrop",
        "title": "Delete Stash",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.deleteBranchMenu",
        "title": "Delete...",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.filterGraph",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterGraph",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.filterCommits",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterCommits",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.filterFileHistory",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterFileHistory",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.changes.commit",
        "title": "Commit",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.changes.commitStaged",
        "title": "Commit Staged",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.changes.commitAmend",
        "title": "Commit Amend",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.changes.stageAll",
        "title": "Stage All",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.changes.unstageAll",
        "title": "Unstage All",
        "category": "GitOrbit",
        "icon": "$(dash)"
      },
      {
        "command": "gitorbit.changes.discardAll",
        "title": "Discard All Changes",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.changes.pull",
        "title": "Pull",
        "category": "GitOrbit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitorbit.changes.push",
        "title": "Push",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.changes.sync",
        "title": "Sync",
        "category": "GitOrbit",
        "icon": "$(sync)"
      },
      {
        "command": "gitorbit.changes.undoCommit",
        "title": "Undo Last Commit",
        "category": "GitOrbit",
        "icon": "$(reply)"
      },
      {
        "command": "gitorbit.changes.stage",
        "title": "Stage Class",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.changes.unstage",
        "title": "Unstage Class",
        "category": "GitOrbit",
        "icon": "$(dash)"
      },
      {
        "command": "gitorbit.changes.openAllChanges",
        "title": "Open All Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitorbit.changes.openAllStaged",
        "title": "Open All Staged Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitorbit.changes.commit",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.changes.pull",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.push",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.sync",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.stageAll",
          "when": "view == gitorbit.views.changes",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.unstageAll",
          "when": "view == gitorbit.views.changes",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.discardAll",
          "when": "view == gitorbit.views.changes",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.openSettings",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@8"
        },
        {
          "command": "gitorbit.refreshChanges",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@9"
        },
        {
          "command": "gitorbit.refreshViews",
          "when": "viewContainer == gitorbit-explorer",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.openSettings",
          "when": "viewContainer == gitorbit-explorer",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.gitflow.menu",
          "when": "view == gitorbit.views.localBranches || view == gitorbit.views.remoteBranches",
          "group": "navigation@3"
        },
        {
          "command": "gitorbit.saveStash",
          "when": "view == gitorbit.views.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.filterGraph",
          "when": "view == gitorbit.views.graph",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterGraph",
          "when": "view == gitorbit.views.graph && gitorbit.graph.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.filterCommits",
          "when": "view == gitorbit.views.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterCommits",
          "when": "view == gitorbit.views.commits && gitorbit.commits.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.filterFileHistory",
          "when": "view == gitorbit.views.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterFileHistory",
          "when": "view == gitorbit.views.fileHistory && gitorbit.fileHistory.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.undoCommit",
          "when": "view == gitorbit.views.changes",
          "group": "more"
        },
        {
          "command": "gitorbit.refreshViews",
          "when": "view == gitorbit.views.localBranches || view == gitorbit.views.remoteBranches || view == gitorbit.views.stashes",
          "group": "title"
        }
      ],
      "view/item/context": [
        {
          "command": "gitorbit.changes.openAllChanges",
          "when": "view == gitorbit.views.changes && viewItem == changesGroup",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.stageAll",
          "when": "view == gitorbit.views.changes && viewItem == changesGroup",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.openAllStaged",
          "when": "view == gitorbit.views.changes && viewItem == stagedGroup",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.unstageAll",
          "when": "view == gitorbit.views.changes && viewItem == stagedGroup",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.openDiff",
          "when": "view == gitorbit.views.changes && (viewItem == change || viewItem == stagedChange)",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.stage",
          "when": "view == gitorbit.views.changes && viewItem == change",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.unstage",
          "when": "view == gitorbit.views.changes && viewItem == stagedChange",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.deleteBranchMenu",
          "when": "view == gitorbit.views.localBranches && viewItem == localBranchNotCurrent",
          "group": "inline@5"
        },
        {
          "command": "gitorbit.deleteRemoteBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "branchActions@1"
        },
        {
          "command": "gitorbit.checkoutCommit",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.fileHistory) && viewItem == commit",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.cherryPick",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.fileHistory) && viewItem == commit",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.checkoutBranch",
          "when": "view == gitorbit.views.localBranches && viewItem == localBranchNotCurrent",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.pushBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.pullBranch",
          "when": "(view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)) || (view == gitorbit.views.remoteBranches && viewItem == remoteBranch)",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.syncBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "inline@4"
        },
        {
          "command": "gitorbit.checkoutBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.openCommitDiffs",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@0"
        },
        {
          "command": "gitorbit.stashApply",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.stashPop",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.stashDrop",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.openCommitDiffs",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "GitOrbit",
      "properties": {
        "gitorbit.blame.inline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline blame ghost text."
        },
        "gitorbit.views.showChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide the Changes view."
        },
        "gitorbit.views.showLocalBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Local Branches."
        },
        "gitorbit.views.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Remote Branches."
        },
        "gitorbit.views.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide the Graph view."
        },
        "gitorbit.views.showCommits": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Commit History."
        },
        "gitorbit.views.showFileHistory": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide File History."
        },
        "gitorbit.views.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Stashes."
        },
        "gitorbit.gitflow.featurePrefix": {
          "type": "string",
          "default": "feature/",
          "description": "Prefix for feature branches."
        },
        "gitorbit.gitflow.hotfixPrefix": {
          "type": "string",
          "default": "hotfix/",
          "description": "Prefix for hotfix branches."
        },
        "gitorbit.views.commitLimit": {
          "type": "number",
          "default": 20,
          "description": "Number of commits to load initially."
        },
        "gitorbit.sync.autoSyncInterval": {
          "type": "number",
          "default": 10,
          "description": "Auto sync interval in minutes (0 to disable)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build": "npm run compile",
    "package": "rm -rf ./out && vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.44.0",
    "typescript": "^5.1.3"
  }
}
