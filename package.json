{
  "name": "gitorbit",
  "displayName": "Git Manager",
  "description": "Simplify your Git management with AI assistance. Features include smart commit messages, code smell detection, and conversational AI to help you manage your workflow effortlessly.",
  "version": "1.0.14",
  "publisher": "selcuksarikoz",
  "icon": "assets/icons/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/selcuksarikoz/git-orbit"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "ai",
    "commit",
    "blame",
    "history",
    "scm",
    "llm",
    "smart-commit",
    "openai",
    "gemini",
    "anthropic",
    "code-review",
    "annotation"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "bundle": "node ./esbuild.js --production",
    "package": "rm -rf ./dist && vsce package",
    "test": "vscode-test",
    "prettier": "prettier --write . --cache"
  },
  "contributes": {
    "views": {
      "gitorbit-explorer": [
        {
          "id": "gitorbit.views.changes",
          "name": "Changes",
          "icon": "$(git-commit)",
          "when": "config.gitorbit.views.showChanges"
        },
        {
          "id": "gitorbit.views.localBranches",
          "name": "Local Branches",
          "icon": "$(git-branch)",
          "when": "config.gitorbit.views.showLocalBranches"
        },
        {
          "id": "gitorbit.views.graph",
          "name": "Graph",
          "icon": "$(graph)",
          "when": "config.gitorbit.views.showGraph",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.commits",
          "name": "Commits history",
          "icon": "$(git-commit)",
          "when": "config.gitorbit.views.showCommits",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.fileHistory",
          "name": "File history",
          "icon": "$(history)",
          "when": "config.gitorbit.views.showFileHistory",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.remoteBranches",
          "name": "Remote Branches",
          "icon": "$(git-branch)",
          "when": "config.gitorbit.views.showRemoteBranches",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.stashes",
          "name": "Stashes",
          "icon": "$(archive)",
          "when": "config.gitorbit.views.showStashes",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.tags",
          "name": "Tags",
          "icon": "$(tag)",
          "when": "config.gitorbit.views.showTags",
          "visibility": "collapsed"
        },
        {
          "id": "gitorbit.views.contributors",
          "name": "Contributors",
          "icon": "$(person)",
          "when": "config.gitorbit.views.showContributors",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitorbit-explorer",
          "title": "GitOrbit",
          "icon": "./assets/icons/toolbar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitorbit.openCommitDiff",
        "title": "Open Diff",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.startRemoteBranch",
        "title": "Create Remote Branch...",
        "category": "GitOrbit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitorbit.deleteBranch",
        "title": "Delete Branch",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.forceDeleteBranch",
        "title": "Force Delete Branch",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.deleteRemoteBranch",
        "title": "Delete Remote Branch",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.forceDeleteRemoteBranch",
        "title": "Force Delete Remote Branch",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.cherryPick",
        "title": "Cherry Pick",
        "category": "GitOrbit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitorbit.checkoutCommit",
        "title": "Checkout Commit",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.startBranch",
        "title": "Create Branch...",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.gitflow.menu",
        "title": "Create...",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.refreshViews",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.refreshChanges",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.showWelcome",
        "title": "Show Welcome Page",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.showGitGraph",
        "title": "Show Git Graph",
        "category": "GitOrbit",
        "icon": "$(graph)"
      },
      {
        "command": "gitorbit.openSettings",
        "title": "Open Settings",
        "category": "GitOrbit",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitorbit.pushBranch",
        "title": "Push",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.pullBranch",
        "title": "Pull",
        "category": "GitOrbit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitorbit.syncBranch",
        "title": "Sync",
        "category": "GitOrbit",
        "icon": "$(sync)"
      },
      {
        "command": "gitorbit.checkoutBranch",
        "title": "Checkout",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.saveStash",
        "title": "Stash",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.stashApply",
        "title": "Apply Stash",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.stashPop",
        "title": "Pop Stash",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.openCommitDiffs",
        "title": "Open Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitorbit.stashDrop",
        "title": "Delete Stash",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.deleteBranchMenu",
        "title": "Delete...",
        "category": "GitOrbit",
        "icon": "$(trash)"
      },
      {
        "command": "gitorbit.filterGraph",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterGraph",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.filterCommits",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterCommits",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.filterFileHistory",
        "title": "Filter",
        "category": "GitOrbit",
        "icon": "$(filter)"
      },
      {
        "command": "gitorbit.clearFilterFileHistory",
        "title": "Clear Filter",
        "category": "GitOrbit",
        "icon": "$(close)"
      },
      {
        "command": "gitorbit.changes.commit",
        "title": "Commit",
        "category": "GitOrbit",
        "icon": "$(check)"
      },
      {
        "command": "gitorbit.changes.commitStaged",
        "title": "Commit Staged",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.changes.commitAmend",
        "title": "Commit Amend",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.changes.stageAll",
        "title": "Stage All",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.changes.unstageAll",
        "title": "Unstage All",
        "category": "GitOrbit",
        "icon": "$(dash)"
      },
      {
        "command": "gitorbit.changes.discardAll",
        "title": "Discard All Changes",
        "category": "GitOrbit",
        "icon": "$(discard)"
      },
      {
        "command": "gitorbit.changes.pull",
        "title": "Pull",
        "category": "GitOrbit",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitorbit.changes.push",
        "title": "Push",
        "category": "GitOrbit",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitorbit.changes.sync",
        "title": "Sync",
        "category": "GitOrbit",
        "icon": "$(sync)"
      },
      {
        "command": "gitorbit.changes.undoCommit",
        "title": "Undo Last Commit",
        "category": "GitOrbit",
        "icon": "$(reply)"
      },
      {
        "command": "gitorbit.changes.stage",
        "title": "Stage Class",
        "category": "GitOrbit",
        "icon": "$(plus)"
      },
      {
        "command": "gitorbit.changes.unstage",
        "title": "Unstage Class",
        "category": "GitOrbit",
        "icon": "$(dash)"
      },
      {
        "command": "gitorbit.changes.openAllChanges",
        "title": "Open All Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitorbit.changes.openAllStaged",
        "title": "Open All Staged Changes",
        "category": "GitOrbit",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitorbit.graph.reset",
        "title": "Reset Current Branch to Here...",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.graph.revert",
        "title": "Revert Commit...",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.graph.tag",
        "title": "Create Tag...",
        "category": "GitOrbit",
        "icon": "$(tag)"
      },
      {
        "command": "gitorbit.changes.discard",
        "title": "Discard Changes",
        "category": "GitOrbit",
        "icon": "$(discard)"
      },
      {
        "command": "gitorbit.changes.openFile",
        "title": "Open File",
        "category": "GitOrbit",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitorbit.changes.stashFile",
        "title": "Stash File",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.changes.smartCommit",
        "title": "Smart Commit...",
        "category": "GitOrbit",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitorbit.chatWithCommit",
        "title": "Chat with AI",
        "category": "GitOrbit",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "gitorbit.checkCodeSmells",
        "title": "Check for Code Smells",
        "category": "GitOrbit",
        "icon": "$(search-stop)"
      },
      {
        "command": "gitorbit.donate",
        "title": "Donate/Support",
        "category": "GitOrbit",
        "icon": "$(heart)"
      },
      {
        "command": "gitorbit.showBlameAtCursor",
        "title": "Show Blame Details",
        "category": "GitOrbit",
        "icon": "$(info)"
      },
      {
        "command": "gitorbit.toggleFileBlame",
        "title": "Toggle File Blame (Inline)",
        "category": "GitOrbit",
        "icon": "$(list-unordered)"
      },
      {
        "command": "gitorbit.contributors.openProfile",
        "title": "Open Profile on GitHub",
        "category": "GitOrbit",
        "icon": "$(globe)"
      },
      {
        "command": "gitorbit.tags.refresh",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.contributors.refresh",
        "title": "Refresh",
        "category": "GitOrbit",
        "icon": "$(refresh)"
      },
      {
        "command": "gitorbit.interactiveRebase",
        "title": "Interactive Rebase",
        "category": "GitOrbit",
        "icon": "$(history)"
      },
      {
        "command": "gitorbit.login",
        "title": "Login with Kuulto AI",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.logout",
        "title": "Logout from Kuulto AI",
        "category": "GitOrbit"
      },
      {
        "command": "gitorbit.feedback",
        "title": "Feedback",
        "category": "GitOrbit",
        "icon": "$(comment)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitorbit.changes.commit",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.checkCodeSmells",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_2_extras@1"
        },
        {
          "command": "gitorbit.changes.smartCommit",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.pull",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.push",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.sync",
          "when": "view == gitorbit.views.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.stageAll",
          "when": "view == gitorbit.views.changes && gitorbit.hasUnstagedChanges",
          "group": "gitorbit_1_actions@3"
        },
        {
          "command": "gitorbit.changes.unstageAll",
          "when": "view == gitorbit.views.changes && gitorbit.hasStagedChanges",
          "group": "gitorbit_1_actions@4"
        },
        {
          "command": "gitorbit.changes.discardAll",
          "when": "view == gitorbit.views.changes && gitorbit.hasUnstagedChanges",
          "group": "gitorbit_1_actions@5"
        },
        {
          "command": "gitorbit.openSettings",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_3_settings@1"
        },
        {
          "command": "gitorbit.refreshChanges",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_1_actions@1"
        },
        {
          "command": "gitorbit.refreshViews",
          "when": "viewContainer == gitorbit-explorer",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.openSettings",
          "when": "viewContainer == gitorbit-explorer",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.showGitGraph",
          "when": "view == gitorbit.views.localBranches",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.gitflow.menu",
          "when": "view == gitorbit.views.localBranches",
          "group": "navigation@3"
        },
        {
          "command": "gitorbit.saveStash",
          "when": "view == gitorbit.views.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.filterGraph",
          "when": "view == gitorbit.views.graph",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterGraph",
          "when": "view == gitorbit.views.graph && gitorbit.graph.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.filterCommits",
          "when": "view == gitorbit.views.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterCommits",
          "when": "view == gitorbit.views.commits && gitorbit.commits.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.filterFileHistory",
          "when": "view == gitorbit.views.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.clearFilterFileHistory",
          "when": "view == gitorbit.views.fileHistory && gitorbit.fileHistory.isFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.changes.undoCommit",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_1_actions@2"
        },
        {
          "command": "gitorbit.donate",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_3_donate@1"
        },
        {
          "command": "gitorbit.feedback",
          "when": "view == gitorbit.views.changes",
          "group": "gitorbit_3_donate@2"
        },
        {
          "command": "gitorbit.interactiveRebase",
          "when": "view == gitorbit.views.commits || view == gitorbit.views.graph",
          "group": "navigation"
        },
        {
          "command": "gitorbit.startRemoteBranch",
          "when": "view == gitorbit.views.remoteBranches",
          "group": "navigation@3"
        },
        {
          "command": "gitorbit.refreshViews",
          "when": "view == gitorbit.views.localBranches",
          "group": "navigation@2"
        },
        {
          "command": "gitorbit.refreshViews",
          "when": "view == gitorbit.views.remoteBranches || view == gitorbit.views.stashes || view == gitorbit.views.tags || view == gitorbit.views.contributors || view == gitorbit.views.graph",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitorbit.changes.openAllChanges",
          "when": "view == gitorbit.views.changes && viewItem == changesGroup",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.stageAll",
          "when": "view == gitorbit.views.changes && viewItem == changesGroup",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.discardAll",
          "when": "view == gitorbit.views.changes && viewItem == changesGroup",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.changes.openAllStaged",
          "when": "view == gitorbit.views.changes && viewItem == stagedGroup",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.unstageAll",
          "when": "view == gitorbit.views.changes && viewItem == stagedGroup",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.openDiff",
          "when": "view == gitorbit.views.changes && (viewItem == change || viewItem == change_deleted || viewItem == stagedChange)",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.changes.stage",
          "when": "view == gitorbit.views.changes && (viewItem == change || viewItem == change_deleted)",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.changes.unstage",
          "when": "view == gitorbit.views.changes && viewItem == stagedChange",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.deleteBranchMenu",
          "when": "view == gitorbit.views.localBranches && viewItem == localBranchNotCurrent",
          "group": "inline@5"
        },
        {
          "command": "gitorbit.deleteRemoteBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.forceDeleteRemoteBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch"
        },
        {
          "command": "gitorbit.chatWithCommit",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.fileHistory) && viewItem == commit",
          "group": "inline@0"
        },
        {
          "command": "gitorbit.chatWithCommit",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "inline"
        },
        {
          "command": "gitorbit.checkoutCommit",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.fileHistory) && viewItem == commit",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.cherryPick",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.fileHistory) && viewItem == commit",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.checkoutBranch",
          "when": "view == gitorbit.views.localBranches && viewItem == localBranchNotCurrent",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.pushBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.pullBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.pullBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.syncBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "inline@4"
        },
        {
          "command": "gitorbit.checkoutBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.startBranch",
          "when": "view == gitorbit.views.localBranches && (viewItem == localBranchCurrent || viewItem == localBranchNotCurrent)",
          "group": "branchActions@1"
        },
        {
          "command": "gitorbit.startRemoteBranch",
          "when": "view == gitorbit.views.remoteBranches && viewItem == remoteBranch",
          "group": "branchActions@1"
        },
        {
          "command": "gitorbit.openCommitDiffs",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@0"
        },
        {
          "command": "gitorbit.stashApply",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.stashPop",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.stashDrop",
          "when": "view == gitorbit.views.stashes && viewItem == stash",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.openCommitDiffs",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "inline@1"
        },
        {
          "command": "gitorbit.chatWithCommit",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "inline@2"
        },
        {
          "command": "gitorbit.checkoutCommit",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "2_actions@1"
        },
        {
          "command": "gitorbit.cherryPick",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "2_actions@2"
        },
        {
          "command": "gitorbit.graph.tag",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "3_git_actions@1"
        },
        {
          "command": "gitorbit.graph.revert",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "3_git_actions@2"
        },
        {
          "command": "gitorbit.interactiveRebase",
          "when": "(view == gitorbit.views.commits || view == gitorbit.views.graph) && viewItem == commit",
          "group": "inline"
        },
        {
          "command": "gitorbit.graph.reset",
          "when": "view == gitorbit.views.graph && viewItem == commit",
          "group": "3_git_actions@3"
        },
        {
          "command": "gitorbit.changes.openFile",
          "when": "view == gitorbit.views.changes && viewItem == change",
          "group": "inline@0"
        },
        {
          "command": "gitorbit.changes.discard",
          "when": "view == gitorbit.views.changes && (viewItem == change || viewItem == change_deleted)",
          "group": "inline@3"
        },
        {
          "command": "gitorbit.changes.stashFile",
          "when": "view == gitorbit.views.changes && (viewItem == change || viewItem == change_deleted || viewItem == stagedChange)",
          "group": "2_actions"
        },
        {
          "command": "gitorbit.contributors.openProfile",
          "when": "view == gitorbit.views.contributors && viewItem == contributor",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "gitorbit.showBlameAtCursor",
          "when": "editorTextFocus && config.gitorbit.blame.inline.enabled",
          "group": "navigation@1"
        },
        {
          "command": "gitorbit.toggleFileBlame",
          "when": "resourceScheme == file && config.gitorbit.blame.file.enabled",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "GitOrbit",
      "properties": {
        "gitorbit.ai.authInfo": {
          "type": "string",
          "default": "",
          "markdownDescription": "Log in to access Kuulto AI features. [Login with Kuulto AI](command:gitorbit.login) | [Logout](command:gitorbit.logout)",
          "order": 0
        },
        "gitorbit.blame.inline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline blame ghost text (author information at the end of the line)."
        },
        "gitorbit.blame.gutter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable gutter blame heatmap (color indicators on the edge of the editor)."
        },
        "gitorbit.blame.file.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic vertical file blame view on file open."
        },
        "gitorbit.views.showChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide the Changes view."
        },
        "gitorbit.views.showLocalBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Local Branches."
        },
        "gitorbit.views.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Remote Branches."
        },
        "gitorbit.views.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide the Graph view."
        },
        "gitorbit.views.showCommits": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Commit History."
        },
        "gitorbit.views.showFileHistory": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide File History."
        },
        "gitorbit.views.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Stashes."
        },
        "gitorbit.views.showTags": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Tags."
        },
        "gitorbit.views.showContributors": {
          "type": "boolean",
          "default": true,
          "description": "Show/Hide Contributors."
        },
        "gitorbit.gitflow.featurePrefix": {
          "type": "string",
          "default": "feature/",
          "description": "Prefix for feature branches."
        },
        "gitorbit.gitflow.featureBase": {
          "type": "string",
          "default": "develop",
          "description": "Base branch for features (if empty, user will be prompted)."
        },
        "gitorbit.gitflow.hotfixPrefix": {
          "type": "string",
          "default": "hotfix/",
          "description": "Prefix for hotfix branches."
        },
        "gitorbit.gitflow.hotfixBase": {
          "type": "string",
          "default": "main",
          "description": "Base branch for hotfixes (if empty, user will be prompted)."
        },
        "gitorbit.gitflow.bugfixPrefix": {
          "type": "string",
          "default": "bugfix/",
          "description": "Prefix for bugfix branches."
        },
        "gitorbit.gitflow.bugfixBase": {
          "type": "string",
          "default": "develop",
          "description": "Base branch for bugfixes (if empty, user will be prompted)."
        },
        "gitorbit.gitflow.releasePrefix": {
          "type": "string",
          "default": "release/",
          "description": "Prefix for release branches."
        },
        "gitorbit.gitflow.releaseBase": {
          "type": "string",
          "default": "main",
          "description": "Base branch for releases (if empty, user will be prompted)."
        },
        "gitorbit.views.commitLimit": {
          "type": "number",
          "default": 20,
          "description": "Number of commits to load initially."
        },
        "gitorbit.sync.autoSyncInterval": {
          "type": "number",
          "default": 10,
          "description": "Auto sync interval in minutes (0 to disable)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
